laga_api_call=your_actual_api_key_here

# Browser-safe Supabase configuration. Use the publishable key, never a secret/service-role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only values used by the protected Vercel keep-alive function.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
CRON_SECRET=replace_with_a_long_random_value
